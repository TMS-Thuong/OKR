{
  "$comment": "Per-project map config. The three skills are generic Rails; everything zaico-specific lives here.",
  "default_screen": "users/sessions#new",
  "other_area": "Khác",
  "hidden_controllers": [
    "\\Aapi/",
    "zaico_admin"
  ],
  "features": [
    {
      "name": "Tồn kho",
      "match": "\\A(inventor|stocktaking|shared_inventor|sharing_inventory|bulk_stocked|places|order_points|quantity_management|units|categories|labels|product_master|org_item_master|cross_search_item|weight|items)"
    },
    {
      "name": "Mua hàng",
      "match": "\\A(purchase|quotation|bom_part|production_plan|search_from_purchase)"
    },
    {
      "name": "Bán hàng & giao hàng",
      "match": "\\A(sales_|orders|catalog|packing_slip|deliver|shipping|customer)"
    },
    {
      "name": "Người dùng & quyền",
      "match": "\\A(users|user_|org_user|authorit|permission|session|registration|password|confirmation|profile|invitation|impersonate|daikou|mfa|saml|oauth|device|accounts|company_user|corporate_group|withdraw)"
    },
    {
      "name": "Thanh toán & gói",
      "match": "\\A(subscription|old_subscription|premium|payment|credit_card|coupon|charge_|special_c|option_|account_statement|org_bill|org_monthly|ticket_refund|unpaid|cancel_questionnaire|org_payment|org_special|external_service_charge|next_engine|twics_bill)"
    },
    {
      "name": "Liên lạc & mail",
      "match": "\\A(messag|mail|inbound_mail|flexible_mail|email_template|notification|communication|thread|reaction|participant|unread|fax|twics)"
    },
    {
      "name": "Nhập / xuất dữ liệu",
      "match": "\\A(import|export|storage_file|spreadsheet|excel|pdf_template|template|print|attachment|image|source|drafts|link)"
    },
    {
      "name": "Tác vụ nền",
      "match": "\\A(job_|scheduled_job|execut|migration|variant_migration|synchronize|incomplete|point_in_time|sample)"
    },
    {
      "name": "AI & phân tích",
      "match": "\\A(ai_|assist|open_ai|video_analysis|analys|summar|statuses)"
    },
    {
      "name": "Công ty & tổ chức",
      "match": "\\A(companies|orgs|org_|corporate|switch_company)"
    },
    {
      "name": "Tìm kiếm",
      "match": "\\A(search|unified_search|cross_search|favorite_search)"
    },
    {
      "name": "Cài đặt & hệ thống",
      "match": "\\A(setting|view_setting|function_preference|onboarding|initialization|tutorial|my_guide|sidebar|diagnostic|server_information|kibana|iptables|firmware|repeater|ui|well_known|application|app|debug|preview|web_view|webhook|matching_rule|approval|freee|google_api|ci_medical|kgzaico|mitepon|ttc|translation|zaicon|alexa|mcp|external|base|charge_failure)"
    }
  ],
